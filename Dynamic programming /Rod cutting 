import math



def CutRod(p, n):
    r = [0] * (n + 1)
    s = [0] * (n + 1)

    for j in range(1, n + 1):
        
        current_max = float('-inf')
        
        for i in range(1, j + 1):
            
            if current_max < p[i] + r[j - i]:
                
                current_max = p[i] + r[j - i]
                
                s[j] = i
                
        r[j] = current_max

    return r[n], s[n]
