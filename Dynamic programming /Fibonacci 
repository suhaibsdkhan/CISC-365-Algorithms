def fib(n):
    
    if n<=1:
        return n        #return the base case for 1 and 0
    
    F=[]
    F[0]=0                  #set initial numbers 
    F[1]=1      
    for i in range(1,n):                #generate dynamically and save in F
        F[i]=F[i-2]+F[i-1]
    
    return F[n]


#recursive

def fib(n):
    
    if n<=1:
        return n
    else:
        return fib(n-2)+fib(n-1)
    
    
    